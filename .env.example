# Base URL of the bookings API. Point it at a real backend to drop the mock.
NEXT_PUBLIC_API_URL=/api
# The room is a physical place: «today» and «now» are the office's, not the browser's.
NEXT_PUBLIC_OFFICE_TIME_ZONE=Asia/Almaty
# Artificial latency of the mock API, so loading/submitting states are visible.
MOCK_LATENCY_MS=400
